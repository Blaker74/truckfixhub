function render() { $('threads').replaceChildren(); const visible = posts.filter(match).sort((a,b) => $('sort').value === 'replies' ? (b.comments?.[0]?.count||0)-(a.comments?.[0]?.count||0) : new Date($('sort').value==='newest'?b.created_at:b.updated_at)-new Date($('sort').value==='newest'?a.created_at:a.updated_at)); for (const p of visible) { const card=node('article',undefined,'thread'), tags=node('div'); for (const t of [p.make,p.category]) tags.append(node('span',t,'tag')); if(p.fix_outcome?.trim()) tags.append(node('span','Reported fix','tag fixed')); const h=node('h3'),a=node('a',p.title); a.href='#discussion-'+p.id; h.append(a); card.append(tags,h,node('p',p.body.slice(0,190)+(p.body.length>190?'…':''),'excerpt'),node('div',p.author_name+' · '+(p.comments?.[0]?.count||0)+' replies · '+date(p.updated_at),'meta')); $('threads').append(card); } if(!visible.length) { const empty=node('div',undefined,'empty'); empty.append(node('h3',posts.length?'No matching discussions.':'Be the first to start a truck discussion.'),node('p','Read the starter guides or share a question. Real community posts will appear here as members publish them.','small')); $('threads').append(empty); } message('status',visible.length+' matching discussions from '+posts.length+' loaded. Search covers loaded original posts and repair outcomes.'); }
async function load(reset=true) { if(busy)return; busy=true; $('refresh').disabled=true; $('more').disabled=true; message('status','Loading shared discussions…'); try { ready(); const start=reset?0:offset; const data=check(await db.from('posts').select('*,comments(count)').order('updated_at',{ascending:false}).range(start,start+49)); posts=reset?data:[...new Map([...posts,...data].map(p=>[p.id,p])).values()]; offset=start+data.length; $('more').hidden=data.length<50; render(); } catch(e) { message('status',e.message,true); if(!posts.length) { const empty=node('div',undefined,'empty'); empty.append(node('h3',db?'Discussions are temporarily unavailable.':'The member forum is being connected.'),node('p','The starter guides below are available to read. No question or reply will be saved until the forum connection is working.','small')); $('threads').replaceChildren(empty); } } finally {busy=false; $('refresh').disabled=false; $('more').disabled=false;} }
async function thread(id) { const serial=++requestId; active=null; $('community').hidden=true; $('thread-view').hidden=false; $('owner-actions').hidden=true; $('thread-title').textContent='Loading discussion…'; $('thread-body').textContent=''; $('comments').textContent='Loading replies…'; message('thread-status',''); $('thread-view').scrollIntoView(); try {ready(); const p=check(await db.from('posts').select('*').eq('id',id).single()); if(serial!==requestId)return; active=p; $('thread-title').textContent=p.title; $('thread-meta').textContent=[p.make,p.category,p.author_name,date(p.created_at)].join(' · '); $('thread-body').textContent=p.vehicle+'\n\n'+p.body+(p.fix_outcome?'\n\nWHAT FIXED IT (reported by original poster)\n'+p.fix_outcome:''); $('owner-actions').hidden=!(user && (user.id===p.user_id||moderator)); $('save-fix').hidden=user?.id!==p.user_id; $('fix-text').hidden=user?.id!==p.user_id; $('fix-text').value=p.fix_outcome||''; const comments=check(await db.from('comments').select('*').eq('post_id',id).order('created_at').limit(500)); if(serial!==requestId)return; $('comments').replaceChildren(); if(!comments.length) $('comments').append(node('p','No replies yet. Share relevant experience below.','small')); for(const c of comments) {const block=node('article',undefined,'comment'); block.append(node('div',c.author_name+' · '+date(c.created_at),'meta'),node('div',c.body,'longtext')); const report=node('button','Report reply','btn secondary'); report.onclick=()=>reportContent(id,c.id); block.append(report); if(user&&(user.id===c.user_id||moderator)) {const del=node('button','Delete reply','btn secondary'); del.onclick=async()=>{if(!confirm('Delete this reply?'))return;try{check(await db.from('comments').delete().eq('id',c.id));thread(id);}catch(e){message('thread-status',e.message,true);}};block.append(del);} $('comments').append(block); } if(comments.length===500) $('comments').append(node('p','Showing the first 500 replies.','small')); }catch(e){if(serial!==requestId)return; $('thread-title').textContent='Unable to load discussion'; $('thread-body').textContent=e.message; $('comments').replaceChildren();} }
function route() { const m=location.hash.match(/^#discussion-([0-9a-f-]{36})$/i); if(m) thread(m[1]); else {requestId++; active=null; $('thread-view').hidden=true; $('community').hidden=false;} }
function ask(category) {if(category)$('ask-category').value=category;if($('make').value)$('ask-make').value=$('make').value;$('ask-dialog').showModal();message('ask-status',db?'':'Posting will be available after the forum service is connected.');}
async function reportContent(postId,commentId=null) {try{signedIn();const reason=prompt('Explain the concern. Do not include private information.');if(!reason?.trim())return;check(await db.from('reports').insert({post_id:postId,comment_id:commentId,reason:reason.trim().slice(0,1000)}));message('thread-status','Report saved for moderator review.');}catch(e){message('thread-status',e.message,true);}}
document.querySelectorAll('.ask').forEach(b=>b.onclick=()=>ask()); document.querySelectorAll('.guide-ask').forEach(b=>b.onclick=()=>ask(b.dataset.category)); document.querySelector('#ask-dialog .close').onclick=()=>$('ask-dialog').close(); $('account').onclick=()=>$('auth-dialog').showModal(); $('auth-close').onclick=()=>$('auth-dialog').close();
$('ask-form').onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{signedIn();const p=check(await db.from('posts').insert({author_name:author(),title:$('title').value.trim(),make:$('ask-make').value,category:$('ask-category').value,vehicle:$('vehicle').value.trim(),body:$('symptoms').value.trim()+'\n\nChecks and recent work:\n'+($('checks').value.trim()||'None supplied.')}).select().single());$('ask-dialog').close();$('ask-form').reset();await load();location.hash='discussion-'+p.id;}catch(e){message('ask-status',e.message,true);}finally{button.disabled=false;}};
$('reply-form').onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{signedIn();if(!active)throw new Error('Open a discussion first.');check(await db.from('comments').insert({post_id:active.id,author_name:author(),body:$('reply-text').value.trim()}));$('reply-text').value='';await thread(active.id);message('reply-status','Reply published.');}catch(e){message('reply-status',e.message,true);}finally{button.disabled=false;}};
$('save-fix').onclick=async()=>{try{signedIn();if(!active||active.user_id!==user.id)throw new Error('Only the original poster can report a repair outcome.');check(await db.from('posts').update({fix_outcome:$('fix-text').value.trim()}).eq('id',active.id));await thread(active.id);message('thread-status','Repair outcome saved.');}catch(e){message('thread-status',e.message,true);}};
$('delete-post').onclick=async()=>{try{signedIn();if(!active||!confirm('Delete this discussion and all its replies?'))return;check(await db.from('posts').delete().eq('id',active.id));location.hash='community';await load();}catch(e){message('thread-status',e.message,true);}}; $('report-post').onclick=()=>active&&reportContent(active.id);
async function auth(signup=false){try{ready();if(!$('auth-form').reportValidity())return;const credentials={email:$('email').value.trim(),password:$('password').value};if(recovery){check(await db.auth.updateUser({password:credentials.password}));recovery=false;$('email').required=true;$('email').closest('.field').hidden=false;$('auth-title').textContent='Your TruckFixHub account';$('auth-submit').textContent='Sign in';$('signup').hidden=false;$('reset-password').hidden=false;$('display-name').closest('.field').hidden=false;$('password').value='';message('auth-status','Password changed. You are signed in.');return;} if(signup){const name=$('display-name').value.trim();if(name.length<2)throw new Error('Choose a public display name of at least two characters.');const data=check(await db.auth.signUp({...credentials,options:{data:{display_name:name},emailRedirectTo:location.origin+location.pathname}}));message('auth-status',data.session?'Account created. You are signed in.':'Check your email to confirm your account, then sign in.');}else{check(await db.auth.signInWithPassword(credentials));$('auth-dialog').close();} $('password').value='';}catch(e){message('auth-status',e.message,true);}}
$('auth-form').onsubmit=e=>{e.preventDefault();auth();};$('signup').onclick=()=>auth(true); $('logout').onclick=async()=>{try{ready();check(await db.auth.signOut());$('auth-dialog').close();}catch(e){message('auth-status',e.message,true);}}; $('reset-password').onclick=async()=>{try{ready();if(!$('email').reportValidity())return;check(await db.auth.resetPasswordForEmail($('email').value.trim(),{redirectTo:location.origin+location.pathname}));message('auth-status','If this email has an account, a reset link will be sent.');}catch(e){message('auth-status',e.message,true);}};
async function account(session){user=session?.user||null;moderator=false;$('account').textContent=user?'My account':'Sign in';$('logout').hidden=!user;if(user){const r=await db.from('moderators').select('user_id').eq('user_id',user.id).maybeSingle();moderator=!!r.data;}if(active)thread(active.id);}
if(db){db.auth.onAuthStateChange((event,session)=>{setTimeout(()=>account(session),0);if(event==='PASSWORD_RECOVERY'){recovery=true;$('auth-title').textContent='Choose a new password';$('email').required=false;$('email').closest('.field').hidden=true;$('auth-submit').textContent='Save new password';$('signup').hidden=true;$('reset-password').hidden=true;$('display-name').closest('.field').hidden=true;if(!$('auth-dialog').open)$('auth-dialog').showModal();message('auth-status','Enter your new password and press Save new password.');}});db.auth.getSession().then(r=>account(r.data.session));}
for(const id of ['search','make','category','sort'])$(id).addEventListener(id==='search'?'input':'change',render);document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{state=b.dataset.state;document.querySelectorAll('.tab').forEach(t=>t.setAttribute('aria-pressed',String(t===b)));render();});document.querySelectorAll('.make-link').forEach(a=>a.onclick=()=>{$('make').value=a.dataset.make;render();});$('refresh').onclick=()=>load();$('more').onclick=()=>load(false);$('back').onclick=()=>{location.hash='community';load();};window.addEventListener('hashchange',route);load();route();

</script>
</body>
</html>
